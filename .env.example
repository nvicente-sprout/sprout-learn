# Sprout Learn — environment variable template
# Copy to .env.local (never commit the real file)
# Set these in the Vercel dashboard for production.

# Gemini API key — used server-side only by api/generate-questions.js
GEMINI_API_KEY=<GEMINI_API_KEY>

# Comma-separated list of origins allowed to call the /api/* routes from a browser.
# Set to the production Vercel URL in the Vercel dashboard; defaults to http://localhost:3001 for local dev.
ALLOWED_ORIGINS=https://<your-prod-domain>,http://localhost:3001
